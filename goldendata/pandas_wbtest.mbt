// Independent cross-verification: moontalib outputs vs pandas/pandas-ta
// reference values generated by testdata/generate_fixtures.py (see
// testdata/README.md for the method, versions and tolerance).

///|
fn pd_check(
  actual : Array[Double],
  expected : Array[Double],
  name : String,
) -> Unit raise {
  if actual.length() != expected.length() {
    fail("\{name}: length mismatch \{actual.length()} vs \{expected.length()}")
  }
  for i in 0..<actual.length() {
    let a = actual[i]
    let b = expected[i]
    if a != a || b != b {
      if !(a != a && b != b) {
        fail("\{name}[\{i}]: expected \{b}, got \{a}")
      }
    } else if (a - b).abs() > 0.000000001 {
      fail("\{name}[\{i}]: expected \{b}, got \{a}")
    }
  }
}

///|
/// Deterministic zig-zag series, identical to the one in moontalib_test.
fn pd_zigzag(n : Int32) -> Array[Double] {
  let out : Array[Double] = []
  for i in 0..<n {
    let m = (i % 13).to_double() * 2.0
    let k = (i % 7).to_double() * 1.5
    out.push(100.0 + m - k)
  }
  out
}

///|
fn pd_zigzag_candles(n : Int32) -> @base.Candles {
  let closes = pd_zigzag(n)
  let open : Array[Double] = []
  let high : Array[Double] = []
  let low : Array[Double] = []
  let close : Array[Double] = []
  let volume : Array[Double] = []
  for i in 0..<n {
    let prev = if i == 0 { closes[0] } else { closes[i - 1] }
    open.push(prev)
    close.push(closes[i])
    high.push(if closes[i] > prev { closes[i] + 1.0 } else { prev + 1.0 })
    low.push(if closes[i] < prev { closes[i] - 1.0 } else { prev - 1.0 })
    volume.push(10.0 + i.to_double())
  }
  let candles : @base.Candles = { open, high, low, close, volume, }
  candles
}

///|
test "pandas cross-verification: overlap family" {
  let n = 300
  let candles = pd_zigzag_candles(n)
  let closes = candles.close
  pd_check(@moontalib.sma(closes, 20), pd_sma20, "sma20")
  pd_check(@moontalib.ema(closes, 20), pd_ema20, "ema20")
  pd_check(@moontalib.wma(closes, 20), pd_wma20, "wma20")
  pd_check(@moontalib.hma(closes, 20), pd_hma20, "hma20")
  pd_check(@moontalib.dema(closes, 20), pd_dema20, "dema20")
  pd_check(@moontalib.tema(closes, 20), pd_tema20, "tema20")
  let bb = @moontalib.bbands(closes, 20, ndev=2.0)
  pd_check(bb.middle, pd_bbands_mid, "bbands_mid")
  pd_check(bb.upper, pd_bbands_up, "bbands_up")
  pd_check(bb.lower, pd_bbands_lo, "bbands_lo")
  pd_check(@moontalib.vwma(closes, candles.volume, 20), pd_vwma20, "vwma20")
  pd_check(@moontalib.midpoint(closes, 20), pd_midpoint20, "midpoint20")
  pd_check(@moontalib.midprice(candles, 20), pd_midprice20, "midprice20")
}

///|
test "pandas cross-verification: momentum family" {
  let n = 300
  let candles = pd_zigzag_candles(n)
  let closes = candles.close
  pd_check(@moontalib.rsi(closes, 14), pd_rsi14, "rsi14")
  let md = @moontalib.macd(closes, 12, 26, 9)
  pd_check(md.macd, pd_macd, "macd")
  pd_check(md.signal, pd_macd_signal, "macd_signal")
  pd_check(md.hist, pd_macd_hist, "macd_hist")
  pd_check(@moontalib.roc(closes, 10), pd_roc10, "roc10")
  pd_check(@moontalib.mom(closes, 10), pd_mom10, "mom10")
  pd_check(@moontalib.cmo(closes, 14), pd_cmo14, "cmo14")
  pd_check(@moontalib.trix(closes, 10), pd_trix10, "trix10")
  pd_check(@moontalib.willr(candles, 14), pd_willr14, "willr14")
  let stf = @moontalib.stochf(candles, 14, d_period=3)
  pd_check(stf.k, pd_stochk, "stochk")
  pd_check(stf.d, pd_stochf_d, "stochf_d")
  let st = @moontalib.stoch(candles, 14, k_slowing=3, d_period=3)
  pd_check(st.d, pd_stochd3, "stochd3")
  pd_check(@moontalib.cci(candles, 14), pd_cci14, "cci14")
  pd_check(@moontalib.bop(candles), pd_bop, "bop")
  pd_check(@moontalib.apo(closes, 5, 20, ma_type=@base.Ema), pd_apo, "apo")
  pd_check(@moontalib.ppo(closes, 5, 20, ma_type=@base.Ema), pd_ppo, "ppo")
  let ar = @moontalib.aroon(candles, 14)
  pd_check(ar.up, pd_aroon_up14, "aroon_up14")
  pd_check(ar.down, pd_aroon_down14, "aroon_down14")
  pd_check(@moontalib.aroonosc(candles, 14), pd_aroonosc14, "aroonosc14")
  let uo = @moontalib.ultosc(candles, p1=7, p2=14, p3=28)
  pd_check(uo, pd_ultosc, "ultosc")
}

///|
test "pandas cross-verification: volume family" {
  let n = 300
  let candles = pd_zigzag_candles(n)
  pd_check(@moontalib.obv(candles), pd_obv, "obv")
  pd_check(@moontalib.mfi(candles, 14), pd_mfi14, "mfi14")
  pd_check(@moontalib.ad(candles), pd_ad, "ad")
  pd_check(@moontalib.adosc(candles, 5, 20), pd_adosc, "adosc")
}

///|
test "pandas cross-verification: volatility family" {
  let n = 300
  let candles = pd_zigzag_candles(n)
  pd_check(@moontalib.tr_range(candles), pd_trange, "trange")
  pd_check(@moontalib.atr(candles, 14), pd_atr14, "atr14")
  pd_check(@moontalib.natr(candles, 14), pd_natr14, "natr14")
}

///|
test "pandas cross-verification: statistic family" {
  let n = 300
  let candles = pd_zigzag_candles(n)
  let closes = candles.close
  pd_check(@moontalib.max(closes, 20), pd_max20, "max20")
  pd_check(@moontalib.min(closes, 20), pd_min20, "min20")
  pd_check(@moontalib.sum(closes, 20), pd_sum20, "sum20")
  pd_check(@moontalib.variance(closes, 20), pd_var20, "var20")
  pd_check(@moontalib.stddev(closes, 20), pd_stdev20, "stdev20")
  pd_check(@moontalib.avgdev(closes, 20), pd_avgdev20, "avgdev20")
  pd_check(@moontalib.correl(closes, candles.high, 20), pd_correl20, "correl20")
  let mm = @moontalib.minmaxindex(closes, 20)
  assert_eq(mm.max_idx, pd_minmaxindex_max)
  assert_eq(mm.min_idx, pd_minmaxindex_min)
  pd_check(
    @moontalib.linearreg_slope(closes, 20),
    pd_linearreg_slope20,
    "linearreg_slope20",
  )
  pd_check(
    @moontalib.linearreg_intercept(closes, 20),
    pd_linearreg_intercept20,
    "linearreg_intercept20",
  )
  pd_check(@moontalib.linearreg(closes, 20), pd_linearreg20, "linearreg20")
  pd_check(
    @moontalib.linearreg_angle(closes, 20),
    pd_linearreg_angle20,
    "linearreg_angle20",
  )
  pd_check(@moontalib.tsf(closes, 20), pd_tsf20, "tsf20")
}
